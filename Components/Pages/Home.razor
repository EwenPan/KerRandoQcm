@page "/"

<PageTitle>KerRando QCM</PageTitle>

<div class="welcome-container">
    <div class="hero-card">
        <h1 class="hero-title">KerRando QCM</h1>
        <p class="hero-subtitle">
            Rallye pédestre et questionnaire par étapes.
        </p>

        <div class="action-grid">
            <a href="/inscription" class="action-card action-player">
                    <div class="action-content">
                        <span class="action-title">Rejoindre une équipe</span>
                        <span class="action-desc">Choisissez votre équipe pour commencer</span>
                </div>
                <div class="action-arrow">→</div>
            </a>

            <a href="/admin" class="action-card action-admin">
                <div class="action-content">
                    <span class="action-title">Administration</span>
                    <span class="action-desc">Création des équipes et suivi du parcours</span>
                </div>
                <div class="action-arrow">→</div>
            </a>
        </div>
    </div>
</div>
