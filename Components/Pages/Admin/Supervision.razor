@page "/admin/supervision"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject IGameDataStore Data
@inject GameEventService EventService
@inject GamePlayService GamePlay
@inject ILogger<Supervision> Logger

<PageTitle>Suivi en direct - KerRando QCM</PageTitle>

<div class="admin-container">
    <header class="admin-header">
        <div>
            <h1 class="admin-title">Suivi en direct</h1>
            <p class="admin-subtitle">Progression, réponses, scores et appareils de chaque équipe.</p>
        </div>
        <div class="admin-header-actions">
            <a href="/admin" class="btn-outline-danger">Retour au tableau de bord</a>
            <a href="/projection" class="btn-accent">Ouvrir la projection</a>
        </div>
    </header>

    @if (gameState != null)
    {
        <div class="alert alert-info">État du rallye : @PhaseLabel</div>
    }

    @foreach (var item in teams)
    {
        <section class="admin-card supervision-team" style="border-top: 5px solid @(item.Team.Color ?? "#2563eb")">
            <div class="card-header">
                <h2>@item.Team.Name</h2>
                <strong>@item.Team.TotalScore points · @item.Completed / @item.Route.Count étapes · @item.Status</strong>
            </div>
            <p>
                @if (item.CurrentStep == null)
                {
                    <span>Parcours terminé</span>
                }
                else
                {
                    <span>Étape attendue : @item.CurrentStep.Name · @item.CurrentStep.Destination</span>
                }
            </p>
            <div class="supervision-details">
                <div>
                    <h3>Appareils autorisés</h3>
                    @if (item.Devices.Count == 0)
                    {
                        <p>Aucun téléphone associé.</p>
                    }
                    @foreach (var device in item.Devices)
                    {
                        <p>@(device.IsActive ? "Actif" : "Révoqué") · dernière activité @device.LastSeenAt.ToLocalTime().ToString("HH:mm:ss")</p>
                    }
                </div>
                <div>
                    <h3>Réponses QCM</h3>
                    @if (item.Submissions.Count == 0)
                    {
                        <p>Aucune réponse enregistrée.</p>
                    }
                    @foreach (var submission in item.Submissions)
                    {
                        <div class="supervision-answer" @key="submission.Submission.Id">
                            <p><strong>@submission.StepName</strong> · réponse @submission.Submission.ChosenAnswer · @(submission.Submission.IsCorrect ? "correcte" : "incorrecte") · @submission.Submission.PointsEarned points</p>
                            @if (submission.Question != null)
                            {
                                <p>@submission.Question.Title</p>
                                <div class="supervision-answer-controls">
                                    <select class="select-control" aria-label="Réponse de @item.Team.Name pour @submission.StepName" @bind="answerDrafts[submission.Submission.Id]" disabled="@(savingAnswerId != null || savingGameScoreId != null)">
                                        @foreach (var option in submission.Options)
                                        {
                                            <option value="@option.Choice">@option.Choice · @(submission.Question.AnswerType == AnswerContentType.TEXT ? option.Content : submission.Question.AnswerType == AnswerContentType.IMAGE ? "Photo" : "Son")</option>
                                        }
                                    </select>
                                    <button type="button" class="btn-primary" @onclick="() => SaveAnswer(submission.Submission)" disabled="@(savingAnswerId != null || savingGameScoreId != null)">
                                        @(savingAnswerId == submission.Submission.Id ? "Enregistrement..." : "Enregistrer")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Question supprimée : réponse non modifiable.</p>
                            }
                            @if (answerMessages.TryGetValue(submission.Submission.Id, out var feedback))
                            {
                                <p role="status">@feedback</p>
                            }
                        </div>
                    }
                </div>
                <div>
                    <h3>Scores des jeux</h3>
                    @if (item.GameScores.Count == 0)
                    {
                        <p>Aucun score enregistré.</p>
                    }
                    @foreach (var score in item.GameScores)
                    {
                        <div class="supervision-answer" @key="score.Score.Id">
                            <p><strong>@score.StepName</strong> · @score.Score.RawScore points bruts · @(score.Score.RankPointsAwarded.HasValue ? $"{score.Score.RankPointsAwarded} points de classement" : "classement en attente")</p>
                            @if (score.Step != null)
                            {
                                <label class="form-label" for="game-score-@score.Score.Id">Score brut</label>
                                <div class="supervision-answer-controls">
                                    <input id="game-score-@score.Score.Id" type="number" class="form-control" min="@score.Step.MinPoints" max="@score.Step.MaxPoints" step="1" @bind="gameScoreDrafts[score.Score.Id]" @bind:event="oninput" disabled="@(savingAnswerId != null || savingGameScoreId != null)" />
                                    <button type="button" class="btn-primary" @onclick="() => SaveGameScore(score.Score)" disabled="@(savingAnswerId != null || savingGameScoreId != null || !gameScoreDrafts[score.Score.Id].HasValue)">
                                        @(savingGameScoreId == score.Score.Id ? "Enregistrement..." : "Enregistrer")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">Jeu supprimé : score non modifiable.</p>
                            }
                            @if (gameScoreMessages.TryGetValue(score.Score.Id, out var feedback))
                            {
                                <p role="status">@feedback</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    private List<SupervisedTeam> teams = new();
    private GameState? gameState;
    private readonly Dictionary<string, Choice> answerDrafts = new();
    private readonly Dictionary<string, string> answerMessages = new();
    private string? savingAnswerId;
    private readonly Dictionary<string, int?> gameScoreDrafts = new();
    private readonly Dictionary<string, string> gameScoreMessages = new();
    private string? savingGameScoreId;
    private string PhaseLabel => gameState?.Phase switch
    {
        GamePhase.IN_PROGRESS => "En cours",
        GamePhase.PAUSED => "En pause",
        GamePhase.FINISHED => "Terminé",
        GamePhase.READY => "Prêt à démarrer",
        _ => "En préparation"
    };

    protected override async Task OnInitializedAsync()
    {
        EventService.TeamsChanged += HandleChanged;
        EventService.TeamProgressChanged += HandleTeamChanged;
        EventService.TeamScoreChanged += HandleTeamChanged;
        EventService.GameStateChanged += HandleChanged;
        await LoadData();
    }

    private async Task LoadData()
    {
        var allTeams = await Data.Teams.GetAllAsync();
        var steps = await Data.Steps.GetAllAsync();
        var submissions = await Data.Submissions.GetAllAsync();
        var questions = (await Data.Questions.GetAllAsync()).ToDictionary(question => question.Id);
        var scores = await Data.GameScores.GetAllAsync();
        var devices = await Data.TeamDevices.GetAllAsync();
        gameState = await Data.GameStates.FindOneAsync(_ => true);
        var stepsById = steps.ToDictionary(step => step.Id);
        foreach (var submission in submissions)
            answerDrafts.TryAdd(submission.Id, submission.ChosenAnswer);
        foreach (var score in scores)
            gameScoreDrafts.TryAdd(score.Id, score.RawScore);

        teams = allTeams.Select(team =>
        {
            var route = team.RouteStepIds.Where(stepsById.ContainsKey).Select(stepId => stepsById[stepId]).ToList();
            var completed = Math.Clamp(team.CurrentStep - 1, 0, route.Count);
            var current = completed < route.Count ? route[completed] : null;
            return new SupervisedTeam
            {
                Team = team,
                Route = route,
                Completed = completed,
                CurrentStep = current,
                Status = route.Count == 0 ? "En attente du parcours" : current == null ? "Terminé" : team.StartedAt == null ? "En attente" : "En cours",
                Devices = devices.Where(device => device.TeamId == team.Id).OrderByDescending(device => device.LastSeenAt).ToList(),
                Submissions = submissions.Where(submission => submission.TeamId == team.Id).Select(submission =>
                {
                    var question = questions.GetValueOrDefault(submission.QuestionId);
                    var options = question == null ? new List<AnswerOption>() : question.Options.Count > 0 ? question.Options : new List<AnswerOption>
                    {
                        new() { Choice = Choice.A, Content = question.OptionA },
                        new() { Choice = Choice.B, Content = question.OptionB },
                        new() { Choice = Choice.C, Content = question.OptionC },
                        new() { Choice = Choice.D, Content = question.OptionD }
                    };
                    return new SupervisedSubmission(stepsById.GetValueOrDefault(submission.StepId ?? string.Empty)?.Name ?? "Question", submission, question, options);
                }).ToList(),
                GameScores = scores.Where(score => score.TeamId == team.Id).Select(score => new SupervisedScore(
                    stepsById.GetValueOrDefault(score.StepId)?.Name ?? "Jeu", score, stepsById.GetValueOrDefault(score.StepId) as GameStep)).ToList()
            };
        }).OrderBy(item => item.Team.Name).ToList();
    }

    private async Task HandleChanged()
    {
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleTeamChanged(string _) => HandleChanged();

    private async Task SaveAnswer(Submission submission)
    {
        if (savingAnswerId != null || savingGameScoreId != null) return;
        savingAnswerId = submission.Id;
        answerMessages.Remove(submission.Id);
        try
        {
            var result = await GamePlay.CorrectQcmAnswerAsync(submission.Id, answerDrafts[submission.Id]);
            answerMessages[submission.Id] = result.Message;
            if (result.Accepted)
            {
                await LoadData();
                await EventService.NotifyTeamScoreChangedAsync(submission.TeamId);
                await EventService.NotifyTeamsChangedAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Impossible de corriger la réponse {SubmissionId}", submission.Id);
            answerMessages[submission.Id] = "Impossible d'enregistrer la correction. Réessayez.";
        }
        finally
        {
            savingAnswerId = null;
        }
    }

    private async Task SaveGameScore(GameScore score)
    {
        if (savingAnswerId != null || savingGameScoreId != null || gameScoreDrafts[score.Id] is not int rawScore) return;
        savingGameScoreId = score.Id;
        gameScoreMessages.Remove(score.Id);
        try
        {
            var result = await GamePlay.CorrectGameScoreAsync(score.Id, rawScore);
            gameScoreMessages[score.Id] = result.Message;
            if (result.Accepted)
            {
                await LoadData();
                await EventService.NotifyTeamsChangedAsync();
                foreach (var team in teams.Where(item => item.GameScores.Any(itemScore => itemScore.Score.StepId == score.StepId)))
                    await EventService.NotifyTeamScoreChangedAsync(team.Team.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Impossible de corriger le score de jeu {ScoreId}", score.Id);
            gameScoreMessages[score.Id] = "Impossible d'enregistrer le score. Réessayez.";
        }
        finally
        {
            savingGameScoreId = null;
        }
    }

    public void Dispose()
    {
        EventService.TeamsChanged -= HandleChanged;
        EventService.TeamProgressChanged -= HandleTeamChanged;
        EventService.TeamScoreChanged -= HandleTeamChanged;
        EventService.GameStateChanged -= HandleChanged;
    }

    private sealed class SupervisedTeam
    {
        public Team Team { get; init; } = new();
        public List<Step> Route { get; init; } = new();
        public int Completed { get; init; }
        public Step? CurrentStep { get; init; }
        public string Status { get; init; } = string.Empty;
        public List<TeamDevice> Devices { get; init; } = new();
        public List<SupervisedSubmission> Submissions { get; init; } = new();
        public List<SupervisedScore> GameScores { get; init; } = new();
    }

    private sealed record SupervisedSubmission(string StepName, Submission Submission, Question? Question, List<AnswerOption> Options);
    private sealed record SupervisedScore(string StepName, GameScore Score, GameStep? Step);
}
