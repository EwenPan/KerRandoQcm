@page "/admin/steps"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IGameDataStore Data
@inject IJSRuntime JS
@inject ImageProcessingService ImageService
@inject GameEventService EventService
@inject GamePlayService GamePlay
@inject QrCodeService QrService
@inject NavigationManager Nav
@inject ILogger<Steps> Logger
@using System.Text.Json

<PageTitle>Édition du parcours - KerRando QCM</PageTitle>

@{
    RenderFragment stepEditor = @<section class="admin-card">
        <div class="card-header"><h2 id="step-editor-title">@(isEditing ? "Modifier l'étape" : "Nouvelle étape")</h2></div>
        <div class="admin-two-cols">
            <div class="form-field">
                <label class="form-label" for="stepName">Nom de l'étape</label>
                <input id="stepName" @bind="newStep.Name" class="form-control" placeholder="Ex. Le vieux puits" />
            </div>
            <div class="form-field">
                <label class="form-label" for="stepType">Type</label>
                <select id="stepType" value="@selectedType" @onchange="ChangeStepType" class="select-control">
                    <option value="@StepType.QCM">QCM</option>
                    <option value="@StepType.GAME">Jeu</option>
                </select>
            </div>
            <div class="form-field">
                <label class="form-label" for="destination">Destination</label>
                <input id="destination" @bind="newStep.Destination" class="form-control" placeholder="Ex. Place de l'église" />
            </div>
        </div>
        <div class="form-field">
            <label class="form-label" for="instructions">Consignes</label>
            <textarea id="instructions" @bind="newStep.Instructions" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-field">
            <label class="form-label" for="transitionHint">Indication avant cette étape (obligatoire)</label>
            <textarea id="transitionHint" @bind="newStep.TransitionHint" @bind:event="oninput" required class="form-control" rows="2" placeholder="Indiquez aux équipes où aller ensuite"></textarea>
            <p class="form-help">Cette indication s'affiche pendant la transition vers cette étape.</p>
        </div>
        @if (selectedType == StepType.QCM)
        {
            <div class="step-content-editor">
                <h3>Question QCM</h3>
                <div class="form-field">
                    <label class="form-label" for="questionTitle">Question</label>
                    <input id="questionTitle" @bind="editingQuestion.Title" class="form-control" placeholder="Écrivez la question" />
                </div>
                <div class="form-field">
                    <label class="form-label" for="questionImage">Photo de la question (facultatif)</label>
                    <InputFile id="questionImage" OnChange="HandleQuestionImageSelected" accept="image/*" />
                    @if (!string.IsNullOrWhiteSpace(editingQuestion.ImageData))
                    {
                        <img src="@editingQuestion.ImageData" alt="Aperçu de la photo de la question" class="question-media-preview" />
                        <button type="button" class="btn-outline-danger" @onclick="() => editingQuestion.ImageData = null">Retirer la photo</button>
                    }
                </div>
                <div class="form-field">
                    <label class="form-label" for="answerType">Type des réponses</label>
                    <select id="answerType" @bind="editingQuestion.AnswerType" class="select-control">
                        <option value="@AnswerContentType.TEXT">Texte</option>
                        <option value="@AnswerContentType.AUDIO">Son</option>
                        <option value="@AnswerContentType.IMAGE">Photo</option>
                    </select>
                </div>
                <div class="admin-two-cols">
                    @foreach (var option in editingQuestion.Options)
                    {
                        <div class="form-field">
                            <label class="form-label">Réponse @option.Choice</label>
                            @if (editingQuestion.AnswerType == AnswerContentType.TEXT)
                            {
                                <input @bind="option.Content" class="form-control" placeholder="Texte de la réponse" />
                            }
                            else
                            {
                                <InputFile OnChange="@(args => HandleOptionFileSelected(option, args))" accept="@(editingQuestion.AnswerType == AnswerContentType.IMAGE ? "image/*" : "audio/*")" />
                                <input @bind="option.Content" class="form-control" placeholder="URL du média (facultatif)" />
                                @if (!string.IsNullOrWhiteSpace(option.Content))
                                {
                                    @if (editingQuestion.AnswerType == AnswerContentType.IMAGE)
                                    {
                                        <img src="@option.Content" alt="Réponse @option.Choice" class="question-media-preview" />
                                    }
                                    else
                                    {
                                        <audio controls src="@option.Content"></audio>
                                    }
                                }
                            }
                            @if (editingQuestion.Options.Count > 2)
                            {
                                <button type="button" class="btn-outline-danger" @onclick="() => RemoveOption(option)">Retirer</button>
                            }
                        </div>
                    }
                </div>
                @if (editingQuestion.Options.Count < 4)
                {
                    <button type="button" class="btn-primary step-editor-action" @onclick="AddOption">Ajouter une réponse</button>
                }
                <div class="admin-two-cols">
                    <div class="form-field">
                        <label class="form-label" for="correctAnswer">Bonne réponse</label>
                        <select id="correctAnswer" @bind="editingQuestion.CorrectAnswer" class="select-control">
                            @foreach (var option in editingQuestion.Options)
                            {
                                <option value="@option.Choice">@option.Choice</option>
                            }
                        </select>
                    </div>
                    <div class="form-field"><label class="form-label" for="questionPoints">Points</label><input id="questionPoints" type="number" min="0" @bind="editingQuestion.Points" class="form-control" /></div>
                </div>
            </div>
        }
        else if (newStep is GameStep gameStep)
        {
            <div class="step-content-editor">
                <h3>Barème du jeu</h3>
                <p class="form-help">Indiquez la fourchette de points que l'équipe peut obtenir pour ce jeu.</p>
                <div class="admin-two-cols">
                    <div class="form-field"><label class="form-label" for="minPoints">Points minimum</label><input id="minPoints" type="number" min="0" @bind="gameStep.MinPoints" class="form-control" /></div>
                    <div class="form-field"><label class="form-label" for="maxPoints">Points maximum</label><input id="maxPoints" type="number" min="0" @bind="gameStep.MaxPoints" class="form-control" /></div>
                </div>
            </div>
        }

        <button class="btn-primary step-editor-action" @onclick="AddStep" disabled="@(isSaving || isProcessingMedia)">
            @(isSaving ? "Enregistrement..." : isEditing ? "Enregistrer les modifications" : selectedType == StepType.QCM ? "Enregistrer la question et ajouter l'étape" : "Ajouter l'étape")
        </button>
        @if (isEditing)
        {
            <button type="button" class="btn-outline-danger step-editor-action" @onclick="CancelEdit" disabled="@(isSaving || isProcessingMedia)">Annuler</button>
        }
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(messageIsError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </section>;

    <div class="admin-container">
        <header class="admin-header">
            <div>
                <h1 class="admin-title">Édition du parcours</h1>
                <p class="admin-subtitle">Créez les étapes et leur contenu au même endroit, puis publiez leur ordre aux équipes.</p>
            </div>
            <div class="admin-header-actions">
                <a href="/admin" class="btn-outline-danger">Retour au tableau de bord</a>
            </div>
        </header>

        @if (!isEditing)
        {
            @stepEditor
        }
        else
        {
            <dialog id="step-edit-dialog" class="step-edit-dialog" aria-labelledby="step-editor-title" @oncancel="CancelEdit" @oncancel:preventDefault="true">
                @stepEditor
            </dialog>
        }

    <section class="admin-card">
        <div class="card-header">
            <h2>Ordre du parcours (@steps.Count étapes)</h2>
            <button type="button" class="btn-primary no-print" @onclick="PrintStepQrs" disabled="@(steps.Count == 0)">Imprimer les QR codes</button>
        </div>
        <p class="section-desc">Les parcours de toutes les équipes seront générés automatiquement au lancement, avec des ordres différents et au plus deux étapes consécutives communes.</p>
        <div class="table-responsive">
            <table class="admin-table">
                <thead><tr><th>#</th><th>Étape</th><th>Type</th><th>Contenu</th><th>Destination</th><th>Indication</th><th>QR</th><th>Code de secours</th><th></th></tr></thead>
                <tbody>
                    @foreach (var (step, index) in steps.Select((value, index) => (value, index)))
                    {
                        <tr>
                            <td>@(index + 1)</td>
                            <td><strong>@step.Name</strong><br /><span class="text-muted">@step.Instructions</span></td>
                            <td>@(step is GameStep ? "Jeu" : "QCM")</td>
                            <td>
                                @if (step is GameStep listedGame)
                                {
                                    <span>@listedGame.MinPoints à @listedGame.MaxPoints points</span>
                                }
                                else if (questionTitles.TryGetValue(((QcmStep)step).QuestionId ?? string.Empty, out var title))
                                {
                                    <span>@title</span>
                                }
                                else
                                {
                                    <span class="text-muted">Non configuré</span>
                                }
                            </td>
                            <td>@step.Destination</td>
                            <td>
                                <details>
                                    <summary>@(string.IsNullOrWhiteSpace(step.TransitionHint) ? "Indication obligatoire" : step.TransitionHint)</summary>
                                    <div class="form-field">
                                        <textarea @bind="step.TransitionHint" @bind:event="oninput" required class="form-control" rows="2" aria-label="Indication avant @step.Name (obligatoire)"></textarea>
                                        <button type="button" class="btn-primary" @onclick="() => SaveTransitionHint(step)" disabled="@string.IsNullOrWhiteSpace(step.TransitionHint)">Enregistrer</button>
                                        @if (savedTransitionHintStepId == step.Id)
                                        {
                                            <span role="status">Enregistrée</span>
                                        }
                                        @if (failedTransitionHintStepId == step.Id)
                                        {
                                            <span role="alert">Impossible d'enregistrer l'indication.</span>
                                        }
                                    </div>
                                </details>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(step.QrToken))
                                {
                                    <img src="@QrService.GenerateQrCodeDataUri(step.QrToken!)" alt="QR de @step.Name" class="step-qr-image" />
                                }
                            </td>
                            <td><strong>@step.ShortCode</strong></td>
                            <td>
                                <button type="button" class="btn-primary" @onclick="() => OpenEditor(step.Id)" disabled="@(isSaving || isProcessingMedia)">Modifier</button>
                                <button class="btn-icon-danger" @onclick="() => DeleteStep(step.Id)">Supprimer</button>
                            </td>
                        </tr>
                    }
                    @if (steps.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted">Aucune étape active.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="step-qr-print-sheet" aria-label="QR codes des étapes">
        <h1>QR codes des étapes</h1>
        <div class="step-qr-print-grid">
            @foreach (var step in steps)
            {
                <article class="step-qr-print-item">
                    <h2>@step.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(step.QrToken))
                    {
                        <img src="@QrService.GenerateQrCodeDataUri(step.QrToken)" alt="QR de @step.Name" />
                    }
                    <p>@step.Destination</p>
                    <p>Code de secours : <strong>@step.ShortCode</strong></p>
                </article>
            }
        </div>
    </section>
</div>
}

@code {
    private Step newStep = new QcmStep();
    private Question editingQuestion = CreateQuestion();
    private StepType selectedType = StepType.QCM;
    private List<Step> steps = new();
    private Dictionary<string, string> questionTitles = new();
    private string? message;
    private bool messageIsError;
    private bool isSaving;
    private bool isProcessingMedia;
    private string? savedTransitionHintStepId;
    private string? failedTransitionHintStepId;
    private bool isEditing;
    private bool showEditDialog;
    private Step? creationDraft;
    private Question? creationQuestionDraft;

    protected override async Task OnInitializedAsync() => await LoadData();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!showEditDialog) return;
        showEditDialog = false;
        try
        {
            await JS.InvokeVoidAsync("kerrandoDialogs.open", "step-edit-dialog");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Impossible d'ouvrir la modale de modification de l'étape {StepId}", newStep.Id);
            RestoreCreationDraft();
            messageIsError = true;
            message = "Impossible d'ouvrir la modification. Actualisez la page pour charger la dernière version.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadData()
    {
        steps = (await Data.Steps.GetAllAsync()).Where(step => step.IsActive).ToList();
        questionTitles = (await Data.Questions.GetAllAsync()).ToDictionary(question => question.Id, question => question.Title);
    }

    private void ChangeStepType(ChangeEventArgs args)
    {
        if (!Enum.TryParse<StepType>(args.Value?.ToString(), out var type)) return;
        selectedType = type;
        var previousStep = newStep;
        newStep = type == StepType.QCM ? new QcmStep() : new GameStep();
        newStep.Type = type;
        if (isEditing)
        {
            CopyStepFields(previousStep, newStep);
            if (newStep is QcmStep qcmStep && !string.IsNullOrEmpty(editingQuestion.Id))
            {
                qcmStep.QuestionId = editingQuestion.Id;
            }
        }
        else
        {
            editingQuestion = CreateQuestion();
        }
        message = null;
    }

    private async Task AddStep()
    {
        messageIsError = true;
        if (string.IsNullOrWhiteSpace(newStep.Name) || string.IsNullOrWhiteSpace(newStep.Destination))
        {
            message = "Le nom et la destination sont obligatoires.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newStep.TransitionHint))
        {
            message = "Ajoutez une indication pour cette étape.";
            return;
        }

        if (selectedType == StepType.QCM && (string.IsNullOrWhiteSpace(editingQuestion.Title) || editingQuestion.Options.Count is < 2 or > 4 || editingQuestion.Options.Any(option => string.IsNullOrWhiteSpace(option.Content)) || editingQuestion.Points < 0 || !editingQuestion.Options.Any(option => option.Choice == editingQuestion.CorrectAnswer)))
        {
            message = "Renseignez la question, deux à quatre réponses, une bonne réponse et des points positifs ou nuls.";
            return;
        }

        if (newStep is GameStep gameStep && (gameStep.MinPoints < 0 || gameStep.MaxPoints < gameStep.MinPoints))
        {
            message = "La fourchette de points est invalide.";
            return;
        }

        if (isEditing)
        {
            await SaveEditedStep();
            return;
        }

        isSaving = true;
        newStep.Name = newStep.Name.Trim();
        newStep.Destination = newStep.Destination.Trim();
        newStep.Instructions = newStep.Instructions.Trim();
        newStep.TransitionHint = newStep.TransitionHint.Trim();
        newStep.ShortCode = await GenerateShortCode();
        newStep.QrToken = Guid.NewGuid().ToString("N");

        if (newStep is QcmStep qcmStep)
        {
            CopyOptionsToLegacyFields(editingQuestion);
            editingQuestion.StationId = null;
            await Data.Questions.InsertOneAsync(editingQuestion);
            qcmStep.QuestionId = editingQuestion.Id;
        }

        await Data.Steps.InsertOneAsync(newStep);
        newStep = new QcmStep();
        editingQuestion = CreateQuestion();
        selectedType = StepType.QCM;
        messageIsError = false;
        message = "Étape ajoutée. Générez puis publiez le parcours pour la rendre accessible aux équipes.";
        await LoadData();
        isSaving = false;
    }

    private async Task OpenEditor(string stepId)
    {
        var step = await Data.Steps.FindOneAsync(item => item.Id == stepId);
        if (step == null) return;
        var question = step is QcmStep qcmStep && qcmStep.QuestionId != null
            ? await Data.Questions.FindOneAsync(item => item.Id == qcmStep.QuestionId)
            : null;

        creationDraft = newStep;
        creationQuestionDraft = editingQuestion;
        newStep = step is GameStep game
            ? JsonSerializer.Deserialize<GameStep>(JsonSerializer.Serialize(game))!
            : JsonSerializer.Deserialize<QcmStep>(JsonSerializer.Serialize((QcmStep)step))!;
        selectedType = newStep is GameStep ? StepType.GAME : StepType.QCM;
        newStep.Type = selectedType;
        editingQuestion = question == null ? CreateQuestion() : JsonSerializer.Deserialize<Question>(JsonSerializer.Serialize(question))!;
        if (editingQuestion.Options.Count == 0)
        {
            var legacyOptions = new[] { editingQuestion.OptionA, editingQuestion.OptionB, editingQuestion.OptionC, editingQuestion.OptionD };
            editingQuestion.Options = legacyOptions.Select((content, index) => new AnswerOption { Choice = (Choice)index, Content = content })
                .Where(option => !string.IsNullOrWhiteSpace(option.Content) || option.Choice is Choice.A or Choice.B).ToList();
        }
        message = null;
        isEditing = true;
        showEditDialog = true;
    }

    private void CancelEdit()
    {
        if (isSaving || isProcessingMedia) return;
        RestoreCreationDraft();
        message = null;
    }

    private void RestoreCreationDraft()
    {
        newStep = creationDraft ?? new QcmStep();
        editingQuestion = creationQuestionDraft ?? CreateQuestion();
        selectedType = newStep is GameStep ? StepType.GAME : StepType.QCM;
        creationDraft = null;
        creationQuestionDraft = null;
        isEditing = false;
        showEditDialog = false;
    }

    private static void CopyStepFields(Step source, Step target)
    {
        target.Id = source.Id;
        target.Name = source.Name;
        target.Destination = source.Destination;
        target.Instructions = source.Instructions;
        target.TransitionHint = source.TransitionHint;
        target.QrToken = source.QrToken;
        target.ShortCode = source.ShortCode;
        target.IsActive = source.IsActive;
    }

    private async Task SaveEditedStep()
    {
        isSaving = true;
        try
        {
            if (await Data.Steps.FindOneAsync(item => item.Id == newStep.Id) == null)
            {
                message = "Cette étape n'existe plus.";
                return;
            }
            newStep.Name = newStep.Name.Trim();
            newStep.Destination = newStep.Destination.Trim();
            newStep.Instructions = newStep.Instructions.Trim();
            newStep.TransitionHint = newStep.TransitionHint.Trim();
            newStep.Type = selectedType;
            var scoreTeamIds = new List<string>();
            if (newStep is QcmStep qcmStep)
            {
                editingQuestion.Title = editingQuestion.Title.Trim();
                CopyOptionsToLegacyFields(editingQuestion);
                if (string.IsNullOrEmpty(editingQuestion.Id))
                    await Data.Questions.InsertOneAsync(editingQuestion);
                else
                    scoreTeamIds = await GamePlay.UpdateQuestionAsync(editingQuestion);
                qcmStep.QuestionId = editingQuestion.Id;
            }
            await Data.Steps.ReplaceOneAsync(newStep);
            var affectedTeams = await Data.Teams.FindAsync(team => team.RouteStepIds.Contains(newStep.Id));
            await LoadData();
            RestoreCreationDraft();
            messageIsError = false;
            message = "Étape modifiée.";
            await EventService.NotifyTeamsChangedAsync();
            foreach (var teamId in affectedTeams.Select(team => team.Id).Concat(scoreTeamIds).Distinct())
            {
                await EventService.NotifyTeamProgressChangedAsync(teamId);
                await EventService.NotifyTeamScoreChangedAsync(teamId);
            }
        }
        catch (Exception)
        {
            messageIsError = true;
            message = "Impossible d'enregistrer les modifications. Réessayez.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static Question CreateQuestion() => new()
    {
        Points = 10,
        Options = new List<AnswerOption>
        {
            new() { Choice = Choice.A },
            new() { Choice = Choice.B }
        }
    };

    private void AddOption()
    {
        if (editingQuestion.Options.Count >= 4) return;
        var nextChoice = (Choice)editingQuestion.Options.Count;
        editingQuestion.Options.Add(new AnswerOption { Choice = nextChoice });
    }

    private void RemoveOption(AnswerOption option)
    {
        if (editingQuestion.Options.Count <= 2) return;
        editingQuestion.Options.Remove(option);
        for (var index = 0; index < editingQuestion.Options.Count; index++)
        {
            editingQuestion.Options[index].Choice = (Choice)index;
        }
        if (!editingQuestion.Options.Any(current => current.Choice == editingQuestion.CorrectAnswer))
        {
            editingQuestion.CorrectAnswer = editingQuestion.Options[0].Choice;
        }
    }

    private static void CopyOptionsToLegacyFields(Question question)
    {
        question.OptionA = question.Options.ElementAtOrDefault(0)?.Content ?? string.Empty;
        question.OptionB = question.Options.ElementAtOrDefault(1)?.Content ?? string.Empty;
        question.OptionC = question.Options.ElementAtOrDefault(2)?.Content ?? string.Empty;
        question.OptionD = question.Options.ElementAtOrDefault(3)?.Content ?? string.Empty;
    }

    private async Task HandleOptionFileSelected(AnswerOption option, InputFileChangeEventArgs args)
    {
        isProcessingMedia = true;
        try
        {
            const long maxFileSize = 10 * 1024 * 1024;
            await using var stream = args.File.OpenReadStream(maxFileSize);
            if (editingQuestion.AnswerType == AnswerContentType.IMAGE)
            {
                option.Content = await ImageService.ResizeToDataUriAsync(stream);
            }
            else
            {
                await using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                option.Content = $"data:{args.File.ContentType};base64,{Convert.ToBase64String(memoryStream.ToArray())}";
            }
        }
        catch (Exception ex)
        {
            messageIsError = true;
            message = $"Impossible de traiter le média : {ex.Message}";
        }
        finally
        {
            isProcessingMedia = false;
        }
    }

    private async Task HandleQuestionImageSelected(InputFileChangeEventArgs args)
    {
        isProcessingMedia = true;
        try
        {
            const long maxFileSize = 10 * 1024 * 1024;
            await using var stream = args.File.OpenReadStream(maxFileSize);
            editingQuestion.ImageData = await ImageService.ResizeToDataUriAsync(stream);
        }
        catch (Exception ex)
        {
            messageIsError = true;
            message = $"Impossible de traiter la photo : {ex.Message}";
        }
        finally
        {
            isProcessingMedia = false;
        }
    }

    private async Task<string> GenerateShortCode()
    {
        var existingCodes = (await Data.Steps.GetAllAsync())
            .Where(step => !string.IsNullOrWhiteSpace(step.ShortCode))
            .Select(step => step.ShortCode!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        string code;
        do
        {
            code = Random.Shared.Next(100000, 1000000).ToString();
        }
        while (existingCodes.Contains(code));

        return code;
    }

    private async Task DeleteStep(string stepId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Supprimer cette étape du parcours ?")) return;
        var step = await Data.Steps.FindOneAsync(currentStep => currentStep.Id == stepId);
        await Data.Steps.DeleteOneAsync(currentStep => currentStep.Id == stepId);
        if (step is QcmStep qcmStep && !string.IsNullOrEmpty(qcmStep.QuestionId))
        {
            await Data.Questions.DeleteOneAsync(question => question.Id == qcmStep.QuestionId);
        }
        await LoadData();
    }

    private async Task SaveTransitionHint(Step step)
    {
        var transitionHint = step.TransitionHint.Trim();
        savedTransitionHintStepId = null;
        failedTransitionHintStepId = null;

        try
        {
            await Data.Steps.UpdateOneAsync(currentStep => currentStep.Id == step.Id, currentStep => currentStep.TransitionHint = transitionHint);
            var savedStep = await Data.Steps.FindOneAsync(currentStep => currentStep.Id == step.Id);
            if (savedStep == null || savedStep.TransitionHint != transitionHint)
            {
                failedTransitionHintStepId = step.Id;
                return;
            }

            await LoadData();
            savedTransitionHintStepId = step.Id;
        }
        catch
        {
            failedTransitionHintStepId = step.Id;
        }
    }

    private async Task PrintStepQrs()
    {
        await JS.InvokeVoidAsync("window.print");
    }

}
