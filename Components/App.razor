@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersions

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@FileVersions.AddFileVersionToPath(string.Empty, "css/app.css")" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <div id="components-reconnect-modal" class="components-reconnect-hide" role="alertdialog" aria-modal="true" aria-labelledby="reconnect-title" aria-describedby="reconnect-message">
        <div class="reconnect-content">
            <h1 id="reconnect-title">Connexion interrompue</h1>
            <p id="reconnect-message">Impossible de joindre le serveur.</p>
            <button type="button" class="reconnect-refresh" onclick="window.location.reload()">Actualiser</button>
        </div>
    </div>
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script src="@FileVersions.AddFileVersionToPath(string.Empty, "js/session.js")"></script>
    <script src="@FileVersions.AddFileVersionToPath(string.Empty, "js/qr-scanner.js")"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
